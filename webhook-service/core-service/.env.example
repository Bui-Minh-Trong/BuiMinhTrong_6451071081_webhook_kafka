# Template biến môi trường cho core-service
# Sao chép file này thành .env và điền giá trị thực

# ─── Kafka ───
KAFKA_BROKER=kafka:9092

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── Facebook Graph API ───
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# ─── Anthropic Claude API (dùng để phân tích intent & sentiment) ───
# Lấy tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Slack Webhook (cảnh báo khi có message vào Dead Letter Queue) ───
# Tạo tại: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Rate Limiting ───
RATE_LIMIT_MAX=20        # Số request tối đa trong 1 window
RATE_LIMIT_WINDOW=60     # Window tính bằng giây (60s = 1 phút)

# ─── Circuit Breaker ───
CB_FAILURE_THRESHOLD=10  # Số lỗi liên tiếp để mở circuit
CB_OPEN_DURATION=30      # Số giây circuit breaker giữ trạng thái OPEN

# ─── Retry Service ───
MAX_RETRIES=3            # Số lần retry tối đa trước khi → dead_letter
